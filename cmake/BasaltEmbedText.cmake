# The script half of basalt_embed_text(), run at build time so a changed template rebuilds.

if(NOT DEFINED OUT_HEADER OR NOT DEFINED OUT_SOURCE OR NOT DEFINED TEXT_FILES)
    message(FATAL_ERROR "BasaltEmbedText.cmake: OUT_HEADER, OUT_SOURCE and TEXT_FILES are required")
endif()

string(REPLACE "::" ";" namespaceParts "${TEXT_NAMESPACE}")

# `server_list` to `ServerList`, which is what the constant is named after.
function(basalt_camel_case OUT VALUE)
    string(REPLACE "_" ";" words "${VALUE}")
    set(result "")
    foreach(word ${words})
        string(SUBSTRING "${word}" 0 1 first)
        string(SUBSTRING "${word}" 1 -1 rest)
        string(TOUPPER "${first}" first)
        string(APPEND result "${first}${rest}")
    endforeach()
    set(${OUT} "${result}" PARENT_SCOPE)
endfunction()

set(declarations "")
set(definitions "")
foreach(file ${TEXT_FILES})
    get_filename_component(stem "${file}" NAME_WE)
    basalt_camel_case(camel "${stem}")
    set(constant "k${camel}${NAME_SUFFIX}")
    file(READ "${file}" contents)
    # A raw string cannot hold its own terminator. None of the templates does today; failing here
    # the day one does beats compiling in something quietly different from the file on disk.
    string(FIND "${contents}" ")basalt\"" terminator)
    if(NOT terminator EQUAL -1)
        message(FATAL_ERROR "${file} contains the raw string terminator and cannot be embedded")
    endif()
    string(APPEND declarations "inline constexpr std::string_view ${constant} = R\"basalt(${contents})basalt\";\n\n")
endforeach()

set(guard "#pragma once\n\n#include <string_view>\n\n")
set(open "")
set(close "")
foreach(part ${namespaceParts})
    string(APPEND open "namespace ${part} {\n")
    string(PREPEND close "} // namespace ${part}\n")
endforeach()

file(WRITE "${OUT_HEADER}"
     "// Generated by basalt_embed_text. Edit the files it is generated from, not this one.\n\n"
     "${guard}${open}\n${declarations}${close}")
# One translation unit so the library is not empty, which some archivers refuse.
file(WRITE "${OUT_SOURCE}" "#include <${HEADER_INCLUDE}>\n")
