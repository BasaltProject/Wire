# Resolves third-party dependencies managed by vcpkg and exposes them under the basalt:: namespace.

find_package(c-ares CONFIG REQUIRED)
find_package(doctest CONFIG REQUIRED)
find_package(unofficial-lua CONFIG REQUIRED)
find_package(MbedTLS CONFIG REQUIRED)
find_package(monocypher CONFIG REQUIRED)
find_package(simdjson CONFIG REQUIRED)
find_package(unofficial-sqlite3 CONFIG REQUIRED)
find_package(ZLIB REQUIRED)
find_package(zstd CONFIG REQUIRED)

if(NOT TARGET basalt::cares)
    add_library(basalt_cares INTERFACE)
    target_link_libraries(basalt_cares INTERFACE c-ares::cares)
    if(APPLE)
        find_library(BASALT_CARES_SYSTEM_CONFIGURATION SystemConfiguration REQUIRED)
        find_library(BASALT_CARES_CORE_FOUNDATION CoreFoundation REQUIRED)
        target_link_libraries(basalt_cares INTERFACE ${BASALT_CARES_SYSTEM_CONFIGURATION} ${BASALT_CARES_CORE_FOUNDATION})
    endif()
    add_library(basalt::cares ALIAS basalt_cares)
endif()

if(NOT TARGET basalt::doctest)
    add_library(basalt_doctest INTERFACE)
    target_link_libraries(basalt_doctest INTERFACE doctest::doctest)
    get_target_property(_doctest_inc doctest::doctest INTERFACE_INCLUDE_DIRECTORIES)
    foreach(_dir IN LISTS _doctest_inc)
        if(EXISTS "${_dir}/doctest/doctest.h")
            target_include_directories(basalt_doctest SYSTEM INTERFACE "${_dir}/doctest")
        endif()
    endforeach()
    add_library(basalt::doctest ALIAS basalt_doctest)
endif()

if(NOT TARGET basalt::lua)
    add_library(basalt_lua INTERFACE)
    target_link_libraries(basalt_lua INTERFACE unofficial::lua::lua)
    add_library(basalt::lua ALIAS basalt_lua)
endif()

if(NOT TARGET basalt::mbedtls)
    add_library(basalt_mbedtls INTERFACE)
    target_link_libraries(basalt_mbedtls INTERFACE MbedTLS::mbedtls MbedTLS::mbedx509 MbedTLS::mbedcrypto)
    if(WIN32)
        target_compile_definitions(basalt_mbedtls INTERFACE MBEDTLS_THREADING_C MBEDTLS_THREADING_ALT WIN32_LEAN_AND_MEAN NOMINMAX)
        target_link_libraries(basalt_mbedtls INTERFACE bcrypt)
    else()
        find_package(Threads REQUIRED)
        target_compile_definitions(basalt_mbedtls INTERFACE MBEDTLS_THREADING_C MBEDTLS_THREADING_PTHREAD)
        target_link_libraries(basalt_mbedtls INTERFACE Threads::Threads)
    endif()
    add_library(basalt::mbedtls ALIAS basalt_mbedtls)
endif()

if(NOT TARGET basalt::monocypher)
    add_library(basalt_monocypher INTERFACE)
    target_link_libraries(basalt_monocypher INTERFACE monocypher::monocypher)
    add_library(basalt::monocypher ALIAS basalt_monocypher)
endif()

if(NOT TARGET basalt::simdjson)
    add_library(basalt_simdjson INTERFACE)
    target_link_libraries(basalt_simdjson INTERFACE simdjson::simdjson)
    add_library(basalt::simdjson ALIAS basalt_simdjson)
endif()

if(NOT TARGET basalt::sqlite)
    add_library(basalt_sqlite INTERFACE)
    target_link_libraries(basalt_sqlite INTERFACE unofficial::sqlite3::sqlite3)
    add_library(basalt::sqlite ALIAS basalt_sqlite)
endif()

if(NOT TARGET basalt::zlib)
    add_library(basalt_zlib INTERFACE)
    target_link_libraries(basalt_zlib INTERFACE ZLIB::ZLIB)
    add_library(basalt::zlib ALIAS basalt_zlib)
    get_target_property(_zlib_inc ZLIB::ZLIB INTERFACE_INCLUDE_DIRECTORIES)
    if(_zlib_inc)
        list(GET _zlib_inc 0 _zlib_first_inc)
        set(BASALT_ZLIB_INCLUDE_DIR "${_zlib_first_inc}" CACHE INTERNAL "Path to zlib headers for Shim")
    endif()
endif()

if(NOT TARGET basalt::zstd)
    add_library(basalt_zstd INTERFACE)
    if(TARGET zstd::libzstd_static)
        target_link_libraries(basalt_zstd INTERFACE zstd::libzstd_static)
    else()
        target_link_libraries(basalt_zstd INTERFACE zstd::libzstd)
    endif()
    add_library(basalt::zstd ALIAS basalt_zstd)
endif()
