# Backend selection and fetching for the WebAssembly plugin runtime.
#
# Wasmtime is consumed through the C API from the official prebuilt release (no Rust toolchain in the build), and
# WAMR is built from a pinned source tarball where Wasmtime publishes no binary (FreeBSD). Both downloads are pinned
# by SHA256 and cached under BASALT_WASM_DOWNLOAD_DIR; nothing is looked up on the system.

set(BASALT_WASM_BACKEND "auto" CACHE STRING "WebAssembly backend: auto, wasmtime or wamr")
set_property(CACHE BASALT_WASM_BACKEND PROPERTY STRINGS auto wasmtime wamr)
set(BASALT_WASM_DOWNLOAD_DIR "${CMAKE_BINARY_DIR}/_wasm-cache" CACHE PATH "Where the pinned backend downloads are kept")
set(BASALT_WASMTIME_ROOT "" CACHE PATH "An extracted wasmtime C API release to use instead of downloading one")
set(BASALT_WAMR_ROOT "" CACHE PATH "An extracted WAMR source tree to use instead of downloading one")

set(BASALT_WASMTIME_VERSION "51.0.0")
set(BASALT_WAMR_VERSION "2.4.6")

