        set(BASALT_WASM_BACKEND_RESOLVED "wamr")
    else()
        set(BASALT_WASM_BACKEND_RESOLVED "wasmtime")
    endif()
else()
    set(BASALT_WASM_BACKEND_RESOLVED "${BASALT_WASM_BACKEND}")
endif()

function(basalt_wasm_download URL SHA256 FILE_NAME OUT_DIR)
    set(_archive "${BASALT_WASM_DOWNLOAD_DIR}/${FILE_NAME}")
    set(_dir "${BASALT_WASM_DOWNLOAD_DIR}/${FILE_NAME}.d")
    if(NOT EXISTS "${_dir}.complete")
        if(NOT EXISTS "${_archive}")
            message(STATUS "Downloading ${URL}")
            file(DOWNLOAD "${URL}" "${_archive}.part" EXPECTED_HASH SHA256=${SHA256} STATUS _status SHOW_PROGRESS)
            list(GET _status 0 _code)
            if(NOT _code EQUAL 0)
                file(REMOVE "${_archive}.part")
                message(FATAL_ERROR "Could not download ${URL}: ${_status}. Download it by hand or point "
                                    "BASALT_WASMTIME_ROOT / BASALT_WAMR_ROOT at an extracted copy.")
            endif()
            file(RENAME "${_archive}.part" "${_archive}")
        else()
            file(SHA256 "${_archive}" _actual)
            if(NOT _actual STREQUAL SHA256)
                file(REMOVE "${_archive}")
                message(FATAL_ERROR "${_archive} does not match its pinned SHA256, it was removed: configure again")
            endif()
        endif()
        file(REMOVE_RECURSE "${_dir}")
        file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${_dir}")
        file(WRITE "${_dir}.complete" "")
    endif()
    file(GLOB _children LIST_DIRECTORIES true "${_dir}/*")
    list(GET _children 0 _root)
    set(${OUT_DIR} "${_root}" PARENT_SCOPE)
endfunction()

function(basalt_wasmtime_target_name OUT)
    if(ANDROID)
        if(ANDROID_ABI STREQUAL "x86_64")
            set(_arch "x86_64")
        else()
            set(_arch "aarch64")
        endif()
        set(_os "android")
    else()
        string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _processor)
        if(APPLE AND CMAKE_OSX_ARCHITECTURES)
            list(GET CMAKE_OSX_ARCHITECTURES 0 _processor)
        endif()
        if(_processor MATCHES "^(x86_64|amd64)$")
            set(_arch "x86_64")
        elseif(_processor MATCHES "^(aarch64|arm64)$")
            set(_arch "aarch64")
        else()
            message(FATAL_ERROR "Wasmtime publishes no C API binary for the processor '${CMAKE_SYSTEM_PROCESSOR}'")
        endif()
        if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
            if("${VCPKG_TARGET_TRIPLET}" MATCHES "musl" OR "${CMAKE_C_COMPILER_TARGET}" MATCHES "musl")
                set(_os "musl")
            else()
                set(_os "linux")
            endif()
        elseif(APPLE)
            set(_os "macos")
        elseif(WIN32)
            if(MINGW)
                set(_os "mingw")
            else()
                set(_os "windows")
            endif()
        else()
            message(FATAL_ERROR "Wasmtime publishes no C API binary for ${CMAKE_SYSTEM_NAME}; use -DBASALT_WASM_BACKEND=wamr")
        endif()
    endif()
    set(${OUT} "${_arch}-${_os}" PARENT_SCOPE)
endfunction()

function(basalt_wasmtime_import)
    if(TARGET basalt::wasmtime)
        return()
    endif()
    if(BASALT_WASMTIME_ROOT)
        set(_root "${BASALT_WASMTIME_ROOT}")
    else()
        basalt_wasmtime_target_name(_name)
        set(_sha "${BASALT_WASMTIME_SHA256_${_name}}")
        if(NOT _sha)
            message(FATAL_ERROR "No pinned wasmtime C API artifact for ${_name}")
        endif()
        if(_name MATCHES "windows|mingw")
            set(_ext "zip")
        else()
            set(_ext "tar.xz")
        endif()
        set(_file "wasmtime-v${BASALT_WASMTIME_VERSION}-${_name}-c-api.${_ext}")
        basalt_wasm_download(
            "https://github.com/bytecodealliance/wasmtime/releases/download/v${BASALT_WASMTIME_VERSION}/${_file}"
            "${_sha}" "${_file}" _root)
    endif()

    if(WIN32 AND NOT MINGW)
        set(_library "${_root}/lib/wasmtime.lib")
    else()
        set(_library "${_root}/lib/libwasmtime.a")
    endif()
    if(NOT EXISTS "${_library}" OR NOT EXISTS "${_root}/include/wasmtime.h")
        message(FATAL_ERROR "${_root} is not a wasmtime C API release (missing ${_library} or include/wasmtime.h)")
    endif()

    add_library(basalt_wasmtime STATIC IMPORTED GLOBAL)
    set_target_properties(basalt_wasmtime PROPERTIES
        IMPORTED_LOCATION "${_library}"
        INTERFACE_INCLUDE_DIRECTORIES "${_root}/include"
    )
    if(WIN32)
        target_compile_definitions(basalt_wasmtime INTERFACE WASM_API_EXTERN= WASI_API_EXTERN=)
        target_link_libraries(basalt_wasmtime INTERFACE ws2_32 advapi32 userenv ntdll bcrypt shell32 ole32 kernel32)
    elseif(NOT APPLE)
        find_package(Threads REQUIRED)
        target_link_libraries(basalt_wasmtime INTERFACE Threads::Threads ${CMAKE_DL_LIBS} m)
    endif()
    add_library(basalt::wasmtime ALIAS basalt_wasmtime)
endfunction()

function(basalt_wamr_source OUT)
    if(BASALT_WAMR_ROOT)
        set(${OUT} "${BASALT_WAMR_ROOT}" PARENT_SCOPE)
        return()
    endif()
    set(_file "WAMR-${BASALT_WAMR_VERSION}.tar.gz")
    basalt_wasm_download(
        "https://github.com/bytecodealliance/wasm-micro-runtime/archive/refs/tags/${_file}"
        "${BASALT_WAMR_SHA256}" "${_file}" _root)
    set(${OUT} "${_root}" PARENT_SCOPE)
endfunction()

function(basalt_wamr_asmjit_source OUT)
    set(_file "asmjit-${BASALT_ASMJIT_COMMIT}.tar.gz")
    basalt_wasm_download(
        "https://github.com/asmjit/asmjit/archive/${BASALT_ASMJIT_COMMIT}.tar.gz"
        "${BASALT_ASMJIT_SHA256}" "${_file}" _root)
    set(${OUT} "${_root}" PARENT_SCOPE)
endfunction()
