set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CMAKE_SYSTEM_NAME Darwin)
set(VCPKG_OSX_ARCHITECTURES x86_64)
set(VCPKG_OSX_DEPLOYMENT_TARGET "13.0")
set(VCPKG_BUILD_TYPE release)
set(VCPKG_C_FLAGS "")
set(VCPKG_CXX_FLAGS "")
set(VCPKG_ENV_PASSTHROUGH_UNTRACKED CC CXX)
# Xcode's ld rejects GNU-format archives ('/' members); pin Apple's archiver for every port.
list(APPEND VCPKG_CMAKE_CONFIGURE_OPTIONS -DCMAKE_AR=/usr/bin/ar -DCMAKE_RANLIB=/usr/bin/ranlib)
