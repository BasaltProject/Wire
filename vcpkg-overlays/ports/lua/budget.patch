+/* Basalt: sandbox budget, counted on loop back-edges and Lua calls instead of a count hook. */
+#define BUDGET(L,ci)  { if (l_unlikely(--G(L)->budget < 0)) { savepc(ci); luaV_budget(L); } }
+#define BUDGETFN(L)  { if (l_unlikely(--G(L)->budget < 0)) luaV_budget(L); }
+
+static void luaV_budget (lua_State *L) {
+  global_State *g = G(L);
+  g->budget = g->budgetstep;
+  if (g->budgetfn != NULL) g->budgetfn(L);
+}
